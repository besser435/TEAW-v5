# Unlike TEAW v4, we will allow wandering traders to spawn. 
# They add extra flavor, and make it so we don't need as many custom recipes.

# Toe 5 was meant to be on 26.1, so these have been changed to work on 1.21.1

#gamerule locator_bar false

#gamerule players_sleeping_percentage 20

#gamerule raids false
#gamerule spawner_blocks_work false

#gamerule spawn_wardens false
#gamerule spawn_phantoms false
#gamerule spawn_patrols false

gamerule playersSleepingPercentage 20

gamerule disableRaids false

gamerule doWardenSpawning false
gamerule doInsomnia false
gamerule doPatrolSpawning false
